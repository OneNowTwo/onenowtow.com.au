# Optional. The app falls back to local seed data when these are unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to persist admin edits and waitlist when Supabase is configured.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the utilitarian /admin route.
ADMIN_PASSWORD=sorted-dev

# Optional public site URL for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
