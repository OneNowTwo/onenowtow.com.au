# Looksee environment variables
# Local: copy to .env.local
# Vercel: Project Settings → Environment Variables (Production + Preview)

# Public app URL — MUST be your Vercel URL in production (Mux CORS + metadata)
# Example: https://looksee-xxxxx.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth + user-generated data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mux (required for upload + playback + webhooks)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Never enable on Vercel production
# ALLOW_DEV_MODERATION=true
