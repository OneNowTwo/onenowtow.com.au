# Personal Agent
NODE_ENV=development
APP_URL=http://localhost:3000

# Required for sessions + encrypted Google tokens
SESSION_SECRET=replace-with-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-another-long-random-string

# Pilot allow-list (must match Google account email)
PILOT_EMAIL=michael@onenowtwo.com.au
PILOT_DISPLAY_NAME=Michael

# Google OAuth Web client (Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirects used by the app:
#   {APP_URL}/api/auth/google/callback
#   {APP_URL}/api/connections/google/callback

# ONT CRM Google Sheet (full URL or spreadsheet ID)
ONT_CRM_SHEET_ID=
# ONT_CRM_SHEET_URL=https://docs.google.com/spreadsheets/d/XXXX/edit

# Live model via Vercel AI Gateway (optional locally if using `eve login`)
# AI_GATEWAY_API_KEY=

# Optional remote Postgres for production. Local default: PGlite under .data/pglite
# DATABASE_URL=postgresql://...
PGLITE_DATA_DIR=.data/pglite

# Labelled fixtures for offline UI demos (never shown as live when connected)
FIXTURE_MODE=0

# Emergency local email login (never enable in production)
# ALLOW_DEV_EMAIL_LOGIN=1
