# Personal Agent — copy to .env.local
NODE_ENV=development
SESSION_SECRET=replace-with-long-random-string

# Pilot user (Milestone 1 admits this email only)
PILOT_EMAIL=michael@onenowtwo.com.au
PILOT_DISPLAY_NAME=Michael

# Optional remote Postgres. When unset, local PGlite is used under .data/pglite
# DATABASE_URL=postgresql://user:pass@host/db
PGLITE_DATA_DIR=.data/pglite

# Labelled fixture suggestions for development (never shown as live)
FIXTURE_MODE=1

# AI Gateway / model credentials — configure via `eve login` or provider env
# AI_GATEWAY_API_KEY=

# Milestone 2 — Google OAuth (register against this deployment)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback

# Milestone 2 — ONT CRM sheet
# ONT_CRM_SHEET_ID=
